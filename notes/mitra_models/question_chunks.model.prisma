model question_chunks {
  qc_id            String         @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  question_id      String?        @db.Uuid
  chunk_id         String?        @db.Uuid
  rank             Int?
  similarity_score Float?
  created_at       DateTime?      @default(now()) @db.Timestamp(6)
  file_chunks      file_chunks?   @relation(fields: [chunk_id], references: [chunk_id], onDelete: Cascade, onUpdate: NoAction)
  questions_log    questions_log? @relation(fields: [question_id], references: [question_id], onDelete: Cascade, onUpdate: NoAction)
}
