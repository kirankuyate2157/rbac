model knowledge_base {
  kb_id            String             @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  kb_name          String             @unique @db.VarChar(255)
  description      String?
  created_by       String?            @db.Uuid
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  updated_at       DateTime?          @default(now()) @db.Timestamp(6)
  chat_history_kbs chat_history_kbs[]
  knowledge_access knowledge_access[]
  users            users?             @relation(fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  knowledge_files  knowledge_files[]
  questions_log    questions_log[]
}
