generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model files_references {
  id           Int      @id @default(autoincrement())
  uid          String   @unique @db.VarChar(12)
  name         String   @db.VarChar(50)
  type         String   @db.VarChar(30)
  related_to   String?  @db.VarChar(30)
  rel_id       Int?
  hash         String?  @db.VarChar(64)
  created_date DateTime @default(now()) @db.Timestamptz(6)
  added_by     Int
}

model login {
  id            Int             @id @default(autoincrement())
  uid           String          @unique @db.VarChar(10)
  username      String          @unique @db.VarChar(50)
  password      String          @db.VarChar(255)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @db.Timestamptz(6)
  machines      machines[]
  partners      partners[]
  process       process[]
  process_steps process_steps[]
}

model machines {
  id                Int       @id @default(autoincrement())
  uid               String    @unique @db.VarChar(12)
  code              String    @db.VarChar(50)
  type              String    @db.VarChar(50)
  manufacturer      String?   @db.VarChar(100)
  installation_date DateTime? @db.Date
  warranty_end_date DateTime? @db.Date
  description       String?
  diagram           String?   @db.VarChar(255)
  manual            String?   @db.VarChar(255)
  location          String?   @db.VarChar(255)
  notes             String?
  active            Boolean?  @default(true)
  create_date       DateTime? @default(now()) @db.Timestamp(6)
  added_by          Int?
  login             login?    @relation(fields: [added_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model materials {
  id               Int     @id @default(autoincrement())
  uid              String  @unique @db.VarChar(12)
  name             String  @db.VarChar(255)
  description      String?
  code             String? @db.VarChar(50)
  measurement_unit String? @db.VarChar(50)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model partners {
  id             Int       @id @default(autoincrement())
  uid            String    @unique @db.VarChar(12)
  type           String    @db.VarChar(10)
  name           String    @db.VarChar(255)
  contact        String?   @db.VarChar(50)
  contact_person String?   @db.VarChar(100)
  email          String?   @db.VarChar(255)
  address        String?
  gst_number     String?   @db.VarChar(20)
  status         Boolean?  @default(false)
  partners_from  DateTime? @db.Date
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  updated_at     DateTime? @default(now()) @db.Timestamp(6)
  added_by       Int?
  login          login?    @relation(fields: [added_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model process {
  id            Int             @id @default(autoincrement())
  uid           String          @unique @db.VarChar(12)
  code          String          @db.VarChar(50)
  name          String          @db.VarChar(255)
  description   String?
  created_date  DateTime?       @default(now()) @db.Timestamp(6)
  added_by      Int?
  login         login?          @relation(fields: [added_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  process_steps process_steps[]
}

model process_steps {
  id          Int       @id @default(autoincrement())
  uid         String    @unique @db.VarChar(12)
  process_id  Int
  name        String    @db.VarChar(255)
  description String?
  step_no     Int?
  outsourced  Boolean?  @default(false)
  created     DateTime? @default(now()) @db.Timestamp(6)
  added_by    Int?
  login       login?    @relation(fields: [added_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  process     process   @relation(fields: [process_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
