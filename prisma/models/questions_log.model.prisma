model questions_log {
  question_id      String            @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  user_id          String?           @db.Uuid
  kb_id            String?           @db.Uuid
  question_text    String
  response_text    String?
  response_time_ms Int?
  status           String?           @default("completed") @db.VarChar(50)
  created_at       DateTime?         @default(now()) @db.Timestamp(6)
  question_chunks  question_chunks[]
  knowledge_base   knowledge_base?   @relation(fields: [kb_id], references: [kb_id], onDelete: Cascade, onUpdate: NoAction)
  users            users?            @relation(fields: [user_id], references: [user_id], onUpdate: NoAction)
}
