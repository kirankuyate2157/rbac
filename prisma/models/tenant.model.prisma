model Tenant {
  id                    String   @id @default(uuid())
  name                  String
  domain                String?  @unique
  plan_type             String?
  status                String?
  default_admin_user_id String?  @unique
  storage_limit_mb      Int?     @default(0)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  users       User[]
  userOrgMap  UserOrgMap[]
  roles       Role[]
  sessions    Session[]
  auditLogs   AuditLogs[]
  billingPlan BillingPlan[]
  emailOutbox EmailOutbox[]

  adminUser      User?          @relation("TenantAdmin", fields: [default_admin_user_id], references: [id])
  tenantPolicies TenantPolicy[] // change to one-to-many
}
