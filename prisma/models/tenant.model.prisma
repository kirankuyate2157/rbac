model Tenant {
  id                    String   @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  name                  String   @db.VarChar(255)
  domain                String?  @unique @db.VarChar(255)
  plan_type             String?  @db.VarChar(50)
  status                String?  @db.VarChar(50)
  default_admin_user_id String?  @unique @db.Uuid
  storage_limit_mb      Int?     @default(0)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  users          users[]
  userOrgMap     UserOrgMap[]
  roles          Role[]
  sessions       Session[]
  emailOutbox    EmailOutbox[]
  auditLogs      AuditLogs[]
  tenantPolicies TenantPolicy[]
  tenantBillings TenantBilling[]
  appConfigs     AppConfig[]

  adminUser users? @relation("TenantAdmin", fields: [default_admin_user_id], references: [user_id])
}
