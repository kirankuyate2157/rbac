model knowledge_access {
  access_id                                String          @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  kb_id                                    String?         @db.Uuid
  user_id                                  String?         @db.Uuid
  access_level                             String?         @default("read") @db.VarChar(50)
  granted_at                               DateTime?       @default(now()) @db.Timestamp(6)
  granted_by                               String?         @db.Uuid
  is_selected                              Boolean?        @default(false)
  users_knowledge_access_granted_byTousers users?          @relation("knowledge_access_granted_byTousers", fields: [granted_by], references: [user_id], onUpdate: NoAction)
  knowledge_base                           knowledge_base? @relation(fields: [kb_id], references: [kb_id], onDelete: Cascade, onUpdate: NoAction)
  users_knowledge_access_user_idTousers    users?          @relation("knowledge_access_user_idTousers", fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}
