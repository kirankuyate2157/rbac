generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model chat_history {
  chat_id            String             @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  session_id         String?            @db.Uuid
  user_id            String?            @db.Uuid
  message_type       String             @db.VarChar(20)
  message_text       String
  response_to        String?            @db.Uuid
  created_at         DateTime?          @default(now()) @db.Timestamp(6)
  is_deactivate      Int?               @default(0)
  response           Json?
  chat_history       chat_history?      @relation("chat_historyTochat_history", fields: [response_to], references: [chat_id], onDelete: Cascade, onUpdate: NoAction)
  other_chat_history chat_history[]     @relation("chat_historyTochat_history")
  chat_sessions      chat_sessions?     @relation(fields: [session_id], references: [session_id], onDelete: Cascade, onUpdate: NoAction)
  users              users?             @relation(fields: [user_id], references: [user_id], onUpdate: NoAction)
  chat_history_kbs   chat_history_kbs[]
}

model chat_history_kbs {
  id             String          @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  chat_id        String?         @db.Uuid
  kb_id          String?         @db.Uuid
  chat_history   chat_history?   @relation(fields: [chat_id], references: [chat_id], onDelete: Cascade, onUpdate: NoAction)
  knowledge_base knowledge_base? @relation(fields: [kb_id], references: [kb_id], onDelete: Cascade, onUpdate: NoAction)
}

model chat_sessions {
  session_id   String         @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  user_id      String?        @db.Uuid
  started_at   DateTime?      @default(now()) @db.Timestamp(6)
  ended_at     DateTime?      @db.Timestamp(6)
  kb_list      String[]       @default([])
  name         String?        @db.VarChar(255)
  chat_history chat_history[]
  users        users?         @relation(fields: [user_id], references: [user_id], onUpdate: NoAction)
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model documents {
  id        Int     @default(autoincrement())
  vector_id String?
  source    String?
  page      Int?
  text      String?
  type      String?

  @@ignore
}

model file_chunks {
  chunk_id        String            @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  file_id         String?           @db.Uuid
  chunk_index     Int
  chunk_text      String?
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  page            Int?
  type            String?           @db.VarChar
  vector_id       String?
  knowledge_files knowledge_files?  @relation(fields: [file_id], references: [file_id], onDelete: Cascade, onUpdate: NoAction)
  question_chunks question_chunks[]
}

model knowledge_access {
  access_id                                String          @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  kb_id                                    String?         @db.Uuid
  user_id                                  String?         @db.Uuid
  access_level                             String?         @default("read") @db.VarChar(50)
  granted_at                               DateTime?       @default(now()) @db.Timestamp(6)
  granted_by                               String?         @db.Uuid
  is_selected                              Boolean?        @default(false)
  users_knowledge_access_granted_byTousers users?          @relation("knowledge_access_granted_byTousers", fields: [granted_by], references: [user_id], onUpdate: NoAction)
  knowledge_base                           knowledge_base? @relation(fields: [kb_id], references: [kb_id], onDelete: Cascade, onUpdate: NoAction)
  users_knowledge_access_user_idTousers    users?          @relation("knowledge_access_user_idTousers", fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model knowledge_base {
  kb_id            String             @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  kb_name          String             @unique @db.VarChar(255)
  description      String?
  created_by       String?            @db.Uuid
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  updated_at       DateTime?          @default(now()) @db.Timestamp(6)
  chat_history_kbs chat_history_kbs[]
  knowledge_access knowledge_access[]
  users            users?             @relation(fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  knowledge_files  knowledge_files[]
  questions_log    questions_log[]
}

model knowledge_files {
  file_id          String          @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  kb_id            String?         @db.Uuid
  file_name        String          @db.VarChar(255)
  file_path        String
  file_type        String?         @db.VarChar(50)
  parsing_type     String?         @db.VarChar(50)
  is_selected      Boolean?        @default(false)
  is_embedded      Boolean?        @default(false)
  num_chunks       Int?            @default(0)
  uploaded_by      String?         @db.Uuid
  created_at       DateTime?       @default(now()) @db.Timestamp(6)
  updated_at       DateTime?       @default(now()) @db.Timestamp(6)
  is_deactivate    Int             @default(0) @db.SmallInt
  embedding_status String?         @db.VarChar(100)
  file_description String?
  file_alias_name  String?
  file_chunks      file_chunks[]
  knowledge_base   knowledge_base? @relation(fields: [kb_id], references: [kb_id], onDelete: Cascade, onUpdate: NoAction)
  users            users?          @relation(fields: [uploaded_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model question_chunks {
  qc_id            String         @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  question_id      String?        @db.Uuid
  chunk_id         String?        @db.Uuid
  rank             Int?
  similarity_score Float?
  created_at       DateTime?      @default(now()) @db.Timestamp(6)
  file_chunks      file_chunks?   @relation(fields: [chunk_id], references: [chunk_id], onDelete: Cascade, onUpdate: NoAction)
  questions_log    questions_log? @relation(fields: [question_id], references: [question_id], onDelete: Cascade, onUpdate: NoAction)
}

model question_logs {
  id       Int       @id @default(autoincrement())
  question String
  user_ip  String?   @db.VarChar(45)
  location String?   @db.VarChar(255)
  answer   String?
  log_date DateTime? @default(now()) @db.Timestamp(6)
}

model question_query_log {
  id              String    @id @db.Uuid
  question_id     String?   @db.Uuid
  timestamp       DateTime? @default(now()) @db.Timestamp(6)
  question        String
  user_id         String?   @db.Uuid
  session_id      String?   @db.Uuid
  kb_ids          String[]  @db.Uuid
  hits            Json?
  cached          Boolean?
  context         String?
  message_context Json?
  answer          String?
  status_code     Int?
}

model questions_log {
  question_id      String            @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  user_id          String?           @db.Uuid
  kb_id            String?           @db.Uuid
  question_text    String
  response_text    String?
  response_time_ms Int?
  status           String?           @default("completed") @db.VarChar(50)
  created_at       DateTime?         @default(now()) @db.Timestamp(6)
  question_chunks  question_chunks[]
  knowledge_base   knowledge_base?   @relation(fields: [kb_id], references: [kb_id], onDelete: Cascade, onUpdate: NoAction)
  users            users?            @relation(fields: [user_id], references: [user_id], onUpdate: NoAction)
}

model user_activity {
  activity_id String    @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  user_id     String?   @db.Uuid
  action      String    @db.VarChar(100)
  details     Json?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  kb_id       String[]  @db.Uuid
  users       users?    @relation(fields: [user_id], references: [user_id], onUpdate: NoAction)
}

model users {
  user_id       String    @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  tenant_id     String?   @db.Uuid
  email         String    @unique @db.VarChar(255)
  full_name     String?   @db.VarChar(255)
  username      String?   @unique @db.VarChar(100)
  password_hash String?
  auth_provider String?   @db.VarChar(50)
  role          String?   @default("user") @db.VarChar(50)
  status        String?   @db.VarChar(50)
  last_login_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  // existing relations
  chat_history                                        chat_history[]
  chat_sessions                                       chat_sessions[]
  knowledge_access_knowledge_access_granted_byTousers knowledge_access[] @relation("knowledge_access_granted_byTousers")
  knowledge_access_knowledge_access_user_idTousers    knowledge_access[] @relation("knowledge_access_user_idTousers")
  knowledge_base                                      knowledge_base[]
  knowledge_files                                     knowledge_files[]
  questions_log                                       questions_log[]
  user_activity                                       user_activity[]

  // new relations
  tenant      Tenant?       @relation(fields: [tenant_id], references: [id])
  userOrgMap  UserOrgMap[]
  sessions    Session[]
  auditLogs   AuditLogs[]
  emailOutbox EmailOutbox[]

  tenantAdminOf Tenant[]       @relation("TenantAdmin")
  TenantPolicy  TenantPolicy[]

  @@index([email])
  @@index([tenant_id])
  @@index([role])
}

model AuditLogs {
  id          String   @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  tenant_id   String   @db.Uuid
  user_id     String   @db.Uuid
  actor_role  String? // "admin", "user", "system"
  module      String? // e.g. "chat", "knowledge_base", "user_mgmt"
  action      String // e.g. "CREATE", "UPDATE", "DELETE", "LOGIN"
  target_type String? // e.g. "Message", "Article", "User"
  target_id   String? // ID of the target entity
  status      String? // e.g. "SUCCESS", "FAILED"
  ip_address  String?  @db.VarChar(100)
  user_agent  String?  @db.Text
  description String? // short summary
  metadata    Json? // flexible extra info (old/new values, etc.)
  created_at  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenant_id], references: [id])
  user   users?  @relation(fields: [user_id], references: [user_id])

  @@index([tenant_id])
  @@index([user_id])
  @@index([action])
  @@index([module])
  @@index([created_at])
  @@index([target_type, target_id])
}

model BillingPlan {
  id          String   @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  name        String   @unique
  description String?
  plan_type   String?  @default("BASIC")
  monthly_fee Decimal  @default(0)
  yearly_fee  Decimal? @default(0)
  currency    String?  @default("USD")
  limits      Json? // { max_users: 10, storage_mb: 500, max_projects: 3 }
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  tenantBillings TenantBilling[] // tenants subscribed to this plan
}

model TenantBilling {
  id              String    @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  tenant_id       String    @db.Uuid
  billing_plan_id String    @db.Uuid
  start_date      DateTime  @default(now())
  end_date        DateTime?
  renewal_date    DateTime?
  status          String    @default("ACTIVE") // ACTIVE, EXPIRED, CANCELED
  payment_status  String    @default("PAID") // PAID, PENDING, FAILED
  payment_method  String? // card, paypal, manual, etc.
  last_invoice_id String?
  auto_renew      Boolean   @default(true)
  usage_metrics   Json? // { used_storage_mb: 300, used_users: 5 }
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  tenant      Tenant      @relation(fields: [tenant_id], references: [id])
  billingPlan BillingPlan @relation(fields: [billing_plan_id], references: [id])
  invoices    Invoice[] // optional link to payment history

  @@unique([tenant_id, billing_plan_id])
  @@index([tenant_id])
  @@index([billing_plan_id])
}

model Invoice {
  id                String    @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  tenant_billing_id String    @db.Uuid
  amount            Decimal
  currency          String?   @default("USD")
  status            String    @default("PAID") // PAID, FAILED, REFUNDED
  invoice_date      DateTime  @default(now())
  due_date          DateTime?
  paid_date         DateTime?
  payment_ref       String? // transaction id, stripe id etc.
  metadata          Json?
  created_at        DateTime  @default(dbgenerated("now()")) @db.Timestamp(6)

  tenantBilling TenantBilling @relation(fields: [tenant_billing_id], references: [id])
}

model Role {
  id          String   @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  tenant_id   String   @db.Uuid
  name        String?  @db.VarChar(255)
  description String?  @db.Text
  created_at  DateTime @default(dbgenerated("now()")) @db.Timestamp(6)

  tenant      Tenant           @relation(fields: [tenant_id], references: [id])
  permissions RolePermission[]

  @@index([tenant_id])
  @@index([name])
  @@index([created_at])
}

model RolePermission {
  id             String   @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  role_id        String   @db.Uuid
  permission_key String?  @db.VarChar(255)
  created_at     DateTime @default(dbgenerated("now()")) @db.Timestamp(6)

  role Role @relation(fields: [role_id], references: [id])

  @@index([role_id])
  @@index([permission_key])
  @@index([created_at])
}

model Session {
  id             String    @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  user_id        String    @db.Uuid
  tenant_id      String    @db.Uuid
  device_id      String?   @db.VarChar(255) // Unique device identifier (web, mobile, etc.)
  device_type    String?   @db.VarChar(100) // e.g., 'web', 'android', 'ios', 'desktop'
  device_name    String?   @db.VarChar(255) // Human-readable device name
  ip_address     String?   @db.VarChar(100)
  user_agent     String?   @db.Text // Browser or app info
  location       Json? // Optional: geo-info (country, city, lat, lon)
  created_at     DateTime  @default(now())
  last_active_at DateTime? @default(now()) // Updated on every API request
  expires_at     DateTime? // Optional: session expiry
  revoked_at     DateTime? // When the session was explicitly logged out
  is_active      Boolean   @default(true)
  refresh_token  String?   @db.Text // Hashed refresh token for session (if applicable)
  token_version  Int       @default(0) // For refresh token rotation/invalidation
  provider       String?   @db.VarChar(50) // e.g., 'local', 'google', 'github'
  meta           Json? // Any additional session metadata

  // Relations
  user   users        @relation(fields: [user_id], references: [user_id])
  tenant Tenant       @relation(fields: [tenant_id], references: [id])
  logs   SessionLog[]

  @@index([user_id])
  @@index([tenant_id])
  @@index([is_active])
  @@index([device_id])
  @@index([created_at])
  @@index([last_active_at])
}

model SessionLog {
  id         String   @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  session_id String?  @db.Uuid
  event      String?  @db.VarChar(100)
  provider   String?  @db.VarChar(50)
  ip_address String?  @db.VarChar(100)
  user_agent String?  @db.Text
  details    Json?
  created_at DateTime @default(now())

  session Session? @relation(fields: [session_id], references: [id])

  @@index([session_id])
  @@index([event])
}

// template model prisma

model Tenant {
  id                    String   @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  name                  String   @db.VarChar(255)
  domain                String?  @unique @db.VarChar(255)
  plan_type             String?  @db.VarChar(50)
  status                String?  @db.VarChar(50)
  default_admin_user_id String?  @unique @db.Uuid
  storage_limit_mb      Int?     @default(0)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  users          users[]
  userOrgMap     UserOrgMap[]
  roles          Role[]
  sessions       Session[]
  emailOutbox    EmailOutbox[]
  auditLogs      AuditLogs[]
  tenantPolicies TenantPolicy[]
  tenantBillings TenantBilling[]
  appConfigs     AppConfig[]

  adminUser users? @relation("TenantAdmin", fields: [default_admin_user_id], references: [user_id])
}

model TenantPolicy {
  id               String   @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  tenant_id        String   @db.Uuid
  storage_limit_mb Int?     @default(1024)
  allow_auto_sync  Boolean? @default(true)
  max_sessions     Int      @default(5)
  session_expiry   Int      @default(168) // in hours
  idle_timeout     Int      @default(60)
  enforce_2fa      Boolean  @default(false)
  created_by       String?  @db.Uuid
  updated_at       DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenant_id], references: [id])
  createdBy users? @relation(fields: [created_by], references: [user_id])
}

model UserOrgMap {
  id          String   @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  user_id     String   @db.Uuid
  tenant_id   String   @db.Uuid
  role_in_org String?  @db.VarChar(50)
  created_at  DateTime @default(dbgenerated("now()")) @db.Timestamp(6)

  // Relations
  user   users  @relation(fields: [user_id], references: [user_id])
  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@unique([user_id, tenant_id])
  @@index([tenant_id])
  @@index([user_id])
}

model EmailOutbox {
  id          String    @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  tenant_id   String?   @db.Uuid // Optional link to tenant
  user_id     String?   @db.Uuid // Optional link to user
  to          String    @db.VarChar(255) // Recipient email address
  cc          String?   @db.Text // CC recipients (comma-separated)
  bcc         String?   @db.Text // BCC recipients (comma-separated)
  subject     String    @db.VarChar(255)
  body        String    @db.Text // HTML or text content
  attachments Json? // Optional: list of file URLs or metadata
  isSent      Boolean   @default(false)
  sentAt      DateTime? @db.Timestamp(6)
  scheduledAt DateTime? @db.Timestamp(6) // For scheduled emails
  attempts    Int       @default(0) // Number of send attempts
  lastAttempt DateTime? @db.Timestamp(6)
  created_at  DateTime  @default(dbgenerated("now()")) @db.Timestamp(6)
  updated_at  DateTime  @updatedAt @db.Timestamp(6)

  tenant Tenant? @relation(fields: [tenant_id], references: [id])
  user   users?  @relation(fields: [user_id], references: [user_id])

  @@index([isSent])
  @@index([scheduledAt])
  @@index([tenant_id])
  @@index([user_id])
}

model Idempotency {
  key        String    @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  namespace  String    @db.VarChar(255)
  statusCode Int?
  response   Json?
  headers    Json?
  createdAt  DateTime  @default(dbgenerated("now()")) @db.Timestamp(6)
  updatedAt  DateTime? @db.Timestamp(6)

  @@index([namespace])
  @@index([statusCode])
  @@index([createdAt])
}

model AppConfig {
  id          String   @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  key         String   @unique @db.VarChar(255)
  value       String   @db.Text
  description String?  @db.Text
  tenant_id   String?  @db.Uuid
  created_at  DateTime @default(dbgenerated("now()")) @db.Timestamp(6)
  updated_at  DateTime @updatedAt @db.Timestamp(6)

  tenant Tenant? @relation(fields: [tenant_id], references: [id])
}
