generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Failed_Notification_Logs {
  id              Int       @id @default(autoincrement())
  notification_id Int
  reason          String    @db.Text
  logged_at       DateTime? @default(now()) @db.Timestamp(0)
}

model Group_Items {
  id              Int       @id @default(autoincrement())
  group_id        Int
  reference_id    Int
  reference_label String    @db.VarChar(100)
  created_at      DateTime? @default(now()) @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)

  @@index([group_id], map: "group_id")
  @@index([reference_id, reference_label], map: "reference_id")
}

model Groups {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(255)
  group_type  String?   @db.VarChar(100)
  description String?   @db.Text
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
}

model Notifications {
  id            Int                     @id @default(autoincrement())
  user_id       Int
  type          Notifications_type
  priority      Notifications_priority? @default(medium)
  status        Notifications_status?   @default(pending)
  content       String                  @db.Text
  topic         String?                 @db.VarChar(255)
  created_at    DateTime?               @default(now()) @db.Timestamp(0)
  scheduled_for DateTime?               @db.Timestamp(0)
  retry_count   Int?                    @default(0)
}

model Subscriptions {
  id         Int       @id @default(autoincrement())
  user_id    Int
  topic      String    @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(0)
}

model banner {
  banner_id         Int              @id @default(autoincrement())
  banner_type       String?          @db.VarChar(20)
  name              String?          @db.VarChar(200)
  start_date        DateTime?        @db.Timestamp(0)
  end_date          DateTime?        @db.Timestamp(0)
  description       String?          @db.Text
  inactive          Int?             @default(0)
  mobile_url        String?          @db.VarChar(512)
  created_timestamp DateTime?        @default(now()) @db.Timestamp(0)
  updated_times     DateTime?        @db.Timestamp(0)
  delete_timestamp  DateTime?        @db.Timestamp(0)
  view_sequence     Int?
  ref_id            String?          @db.VarChar(100)
  ref_type          banner_ref_type? @default(CATEGORY)
  reference_url     String?          @db.Text
}

model banner_type {
  type_id           Int       @id @default(autoincrement())
  type_name         String    @db.VarChar(255)
  description       String?   @db.Text
  created_timestamp DateTime? @default(now()) @db.Timestamp(0)
  update_timestamp  DateTime? @db.Timestamp(0)
  delete_timestamp  DateTime? @db.Timestamp(0)
  inactive          Boolean?  @default(false)
}

model cart {
  cart_id    String       @unique(map: "cart_id") @db.Char(36)
  id         Int          @id @default(autoincrement())
  user_id    String       @unique(map: "user_id") @db.VarChar(36)
  created_at DateTime?    @default(now()) @db.Timestamp(0)
  updated_at DateTime?    @default(now()) @db.Timestamp(0)
  users      users        @relation(fields: [user_id], references: [uid], onDelete: Cascade, onUpdate: NoAction, map: "cart_ibfk_1")
  cart_items cart_items[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cart_items {
  cart_item_id String          @unique(map: "cart_item_id") @db.Char(36)
  id           Int             @id @default(autoincrement())
  cart_id      String          @db.Char(36)
  item_id      Int
  quantity     Int             @default(1)
  added_at     DateTime?       @default(now()) @db.Timestamp(0)
  type         cart_items_type @default(STOCK)
  cart         cart            @relation(fields: [cart_id], references: [cart_id], onDelete: Cascade, onUpdate: NoAction, map: "cart_items_ibfk_1")

  @@index([cart_id], map: "cart_id")
  @@index([item_id], map: "item_id")
}

model categories {
  category_id          Int             @id @default(autoincrement()) @db.UnsignedInt
  category_name        String          @default("") @db.VarChar(200)
  category_image       String?         @db.VarChar(200)
  inactive             Boolean         @default(false)
  created_timestamp    DateTime?       @default(now()) @db.Timestamp(0)
  update_timestamp     DateTime?       @db.Timestamp(0)
  delete_timestamp     DateTime?       @db.Timestamp(0)
  parent_category_id   Int?
  category_description String?         @db.VarChar(2000)
  combo_details        combo_details[]

  @@index([category_id], map: "idx_categories_category_id")
  @@index([parent_category_id], map: "idx_categories_parent_category_id")
}

model category_sequence {
  id                 Int       @id @default(autoincrement()) @db.UnsignedInt
  category_id        Int       @unique(map: "category_id") @db.UnsignedInt
  parent_category_id Int?
  sequence           Int
  created_at         DateTime? @default(now()) @db.Timestamp(0)
  updated_at         DateTime? @default(now()) @db.Timestamp(0)

  @@unique([parent_category_id, sequence], map: "uq_parent_sequence")
}

model cod_payments {
  id                 Int                          @id @default(autoincrement()) @db.UnsignedInt
  payment_id         String                       @unique(map: "payment_id") @db.Char(50)
  order_id           String?                      @db.Char(36)
  payment_method     cod_payments_payment_method? @default(cod)
  amount             Decimal                      @db.Decimal(15, 2)
  wallet_amount      Decimal?                     @default(0.00) @db.Decimal(15, 2)
  cod_amount         Decimal?                     @default(0.00) @db.Decimal(15, 2)
  transaction_id     String?                      @unique(map: "transaction_id") @db.Char(50)
  payment_status     cod_payments_payment_status? @default(pending)
  created_at         DateTime?                    @default(now()) @db.Timestamp(0)
  updated_at         DateTime?                    @default(now()) @db.Timestamp(0)
  notes              String?                      @db.Text
  proof_of_payment   String?                      @db.Text
  collecting_user_id String                       @db.Char(36)
}

model combo_details {
  id                   Int              @id @default(autoincrement()) @db.UnsignedInt
  name                 String           @db.VarChar(200)
  description          String           @db.VarChar(2000)
  category_id          Int              @db.UnsignedInt
  cost                 Float            @db.Float
  department           String           @default("GROCERY") @db.VarChar(100)
  inactive             Int?             @default(0)
  created_timestamp    DateTime?        @default(now()) @db.Timestamp(0)
  updated_timestamp    DateTime?        @db.Timestamp(0)
  deleted_timestamp    DateTime?        @db.Timestamp(0)
  discount             Decimal?         @db.Decimal(5, 2)
  allow_extra_discount Boolean?         @default(false)
  categories           categories       @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_category_id")
  section_layout       section_layout[]

  @@index([category_id], map: "fk_category_id")
  @@index([id], map: "idx_combo_details_id")
}

model combos {
  id                Int          @id @default(autoincrement()) @db.UnsignedInt
  combo_id          Int          @db.UnsignedInt
  stock_id          Int
  quantities        Int
  inactive          Int          @default(0)
  created_timestamp DateTime?    @default(now()) @db.Timestamp(0)
  updated_timestamp DateTime?    @db.Timestamp(0)
  deleted_timestamp DateTime?    @db.Timestamp(0)
  stock_master      stock_master @relation(fields: [stock_id], references: [stock_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_stock_id")

  @@unique([combo_id, stock_id], map: "combo_id")
  @@index([stock_id], map: "fk_stock_id")
}

model complaints {
  uid               String?              @unique(map: "uid") @db.VarChar(36)
  id                BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  order_id          String               @unique(map: "order_id") @db.Char(36)
  status            complaints_status?   @default(PENDING)
  details           String?              @db.Text
  actions           String?              @db.Text
  severity          complaints_severity? @default(LOW)
  inactive          Int?                 @default(0) @db.TinyInt
  created_timestamp DateTime?            @default(now()) @db.Timestamp(0)
  updated_timestamp DateTime?            @default(now()) @db.Timestamp(0)
  source            String?              @default("WEB") @db.VarChar(50)
  user_id           String?              @db.Char(36)
}

model custom_unit {
  id                  Int                       @id @default(autoincrement())
  unit_category       custom_unit_unit_category
  display_unit        Int?
  display_quantity_id Int?
  name                String?                   @db.VarChar(255)
  sale_as_per_piece   Int?                      @default(1) @db.TinyInt
  inactive            Int?                      @default(0) @db.TinyInt
  created_at          DateTime?                 @default(now()) @db.Timestamp(0)
  updated_at          DateTime?                 @default(now()) @db.Timestamp(0)

  @@unique([display_unit, display_quantity_id, name], map: "unique_display_unit_quantity_name")
  @@index([display_unit], map: "idx_custom_unit_display_unit")
  @@index([id], map: "idx_custom_unit_id")
}

