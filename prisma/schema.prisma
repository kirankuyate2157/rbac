datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AuditLogs {
  id          String   @id @default(uuid())
  tenant_id   String?
  user_id     String?
  actor_role  String? // "admin", "user", "system"
  module      String? // e.g. "chat", "knowledge_base", "user_mgmt"
  action      String // e.g. "CREATE", "UPDATE", "DELETE", "LOGIN"
  target_type String? // e.g. "Message", "Article", "User"
  target_id   String? // ID of the target entity
  status      String? // e.g. "SUCCESS", "FAILED"
  ip_address  String?  @db.VarChar(100)
  user_agent  String?  @db.Text
  description String? // short summary
  metadata    Json? // flexible extra info (old/new values, etc.)
  created_at  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenant_id], references: [id])
  user   User?   @relation(fields: [user_id], references: [id])

  @@index([tenant_id])
  @@index([user_id])
  @@index([action])
  @@index([module])
  @@index([created_at])
}

model BillingPlan {
  id           String   @id @default(uuid())
  name         String?
  monthly_fee  Decimal?
  x_per_charge Decimal?
  limits       Json?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  tenant_id    String?
  tenant       Tenant?  @relation(fields: [tenant_id], references: [id])
}

model Role {
  id          String   @id @default(uuid())
  tenant_id   String
  name        String?
  description String?
  created_at  DateTime @default(now())

  tenant      Tenant           @relation(fields: [tenant_id], references: [id])
  permissions RolePermission[]
}

model RolePermission {
  id             String   @id @default(uuid())
  role_id        String
  permission_key String?
  created_at     DateTime @default(now())

  role Role @relation(fields: [role_id], references: [id])
}

model Session {
  id             String    @id @default(uuid())
  user_id        String
  tenant_id      String
  device_id      String?   @db.VarChar(255) // Unique device identifier (web, mobile, etc.)
  device_type    String?   @db.VarChar(100) // e.g., 'web', 'android', 'ios', 'desktop'
  device_name    String?   @db.VarChar(255) // Human-readable device name
  ip_address     String?   @db.VarChar(100)
  user_agent     String?   @db.Text // Browser or app info
  location       Json? // Optional: geo-info (country, city, lat, lon)
  created_at     DateTime  @default(now())
  last_active_at DateTime? @default(now()) // Updated on every API request
  expires_at     DateTime? // Optional: session expiry
  revoked_at     DateTime? // When the session was explicitly logged out
  is_active      Boolean   @default(true)
  refresh_token  String?   @db.Text // Hashed refresh token for session (if applicable)
  token_version  Int       @default(0) // For refresh token rotation/invalidation
  provider       String?   @db.VarChar(50) // e.g., 'local', 'google', 'github'
  meta           Json? // Any additional session metadata

  // Relations
  user   User         @relation(fields: [user_id], references: [id])
  tenant Tenant       @relation(fields: [tenant_id], references: [id])
  logs   SessionLog[]

  @@index([user_id])
  @@index([tenant_id])
  @@index([is_active])
  @@index([device_id])
  @@index([created_at])
  @@index([last_active_at])
}

model SessionLog {
  id         String   @id @default(uuid())
  session_id String?
  event      String?  @db.VarChar(100)
  provider   String?  @db.VarChar(50)
  ip_address String?  @db.VarChar(100)
  user_agent String?  @db.Text
  details    Json?
  created_at DateTime @default(now())

  session Session? @relation(fields: [session_id], references: [id])

  @@index([session_id])
  @@index([event])
}

// template model prisma

model Tenant {
  id                    String   @id @default(uuid())
  name                  String
  domain                String?  @unique
  plan_type             String?
  status                String?
  default_admin_user_id String?  @unique
  storage_limit_mb      Int?     @default(0)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  users       User[]
  userOrgMap  UserOrgMap[]
  roles       Role[]
  sessions    Session[]
  auditLogs   AuditLogs[]
  billingPlan BillingPlan[]
  emailOutbox EmailOutbox[]

  adminUser      User?          @relation("TenantAdmin", fields: [default_admin_user_id], references: [id])
  tenantPolicies TenantPolicy[] // change to one-to-many
}

model TenantPolicy {
  id               String   @id @default(uuid())
  tenant_id        String
  storage_limit_mb Int?     @default(1024)
  allow_auto_sync  Boolean? @default(true)
  max_sessions    Int      @default(5)
  session_expiry  Int      @default(168) // in hours
  idle_timeout    Int      @default(60)
  enforce_2fa     Boolean  @default(false)
  created_by       String?
  updated_at       DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenant_id], references: [id])
  createdBy User?  @relation(fields: [created_by], references: [id])
}

model User {
  id            String    @id @default(uuid())
  tenant_id     String?
  email         String    @unique
  full_name     String?
  username      String?
  password_hash String?
  auth_provider String?
  role          String?
  status        String?
  last_login_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  ip_address    String?
  user_agent    String?

  tenant      Tenant?       @relation(fields: [tenant_id], references: [id])
  userOrgMap  UserOrgMap[]
  sessions    Session[]
  auditLogs   AuditLogs[]
  emailOutbox EmailOutbox[]

  tenantAdminOf Tenant[]       @relation("TenantAdmin")
  TenantPolicy  TenantPolicy[]

  @@index([email])
  @@index([tenant_id])
  @@index([role])
}

model UserOrgMap {
  id          String   @id @default(uuid())
  user_id     String
  tenant_id   String
  role_in_org String?
  created_at  DateTime @default(now())

  user   User   @relation(fields: [user_id], references: [id])
  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@unique([user_id, tenant_id])
}

model EmailOutbox {
  id          String    @id @default(uuid())
  tenant_id   String? // Optional, link to tenant
  user_id     String? // Optional, link to user
  to          String // Recipient email address
  cc          String? // CC recipients (comma-separated)
  bcc         String? // BCC recipients (comma-separated)
  subject     String
  body        String // HTML or text content
  attachments Json? // Optional: list of file URLs or metadata
  isSent      Boolean   @default(false)
  sentAt      DateTime?
  scheduledAt DateTime? // For scheduled emails
  attempts    Int       @default(0) // Number of send attempts
  lastAttempt DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  tenant Tenant? @relation(fields: [tenant_id], references: [id])
  user   User?   @relation(fields: [user_id], references: [id])

  @@index([isSent])
  @@index([scheduledAt])
  @@index([tenant_id])
}

model Idempotency {
  key        String    @id @default(uuid())
  namespace  String
  statusCode Int?
  response   Json?
  headers    Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime?
}


model AppConfig {
  id           String  @id @default(uuid())
  key          String  @unique
  value        String
  description  String?
  tenant_id    String? 
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}
