model frame_results {
  id                   Int       @id @default(autoincrement())
  site_id              Int
  feed_id              Int
  frame_index          Int
  ts                   Float?
  timestamp_dt         DateTime? @db.Timestamp(6)
  mode                 String?   @db.VarChar(50)
  rois                 Json?
  total_obj_count      Json?
  total_obj_inside_roi Json?
  time_condition       Boolean?  @default(false)
  sups                 Json?
  created_at           DateTime? @default(now()) @db.Timestamp(6)
}
