model users {
  id           Int       @id @default(autoincrement())
  uid          String?   @unique(map: "uid") @db.VarChar(36)
  account_id   Int?
  password     String?   @default("") @db.VarChar(100)
  full_name    String    @default("") @db.VarChar(100)
  mobile_no    String?   @default("") @db.VarChar(30)
  email        String?   @db.VarChar(100)
  type         String?   @default("CUST") @db.VarChar(10)
  inactive     Boolean?  @default(false)
  updated_date DateTime? @db.Timestamp(0)
  created_date DateTime? @default(now()) @db.Timestamp(0)
  deleted_date DateTime? @db.Timestamp(0)
  gender       String?   @db.VarChar(15)
  birth_date   DateTime? @db.Date
  department   String?   @db.VarChar(50)
  user_role    String?   @db.VarChar(50)
  company_name String?   @db.VarChar(100)
  accounts     accounts? @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_users_account")

  @@index([account_id], map: "fk_users_account")
}
