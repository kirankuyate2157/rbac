model detection_rules {
  id                  Int                           @id @default(autoincrement())
  site_id             Int
  feed_id             Int
  static_item_id      Int?
  dynamic_class_id    Int?
  name                String?                       @db.VarChar(255)
  description         String?                       @db.Text
  trigger_type        detection_rules_trigger_type? @default(entry)
  count_threshold     Int?                          @default(1)
  time_window_seconds Int?                          @default(60)
  active_from         DateTime?                     @db.Time(0)
  active_to           DateTime?                     @db.Time(0)
  active_days         Json?
  action_type         detection_rules_action_type?  @default(alert)
  action_config       Json?
  is_active           Boolean?                      @default(true)
  created_at          DateTime?                     @default(now()) @db.DateTime(0)
  sites               sites                         @relation(fields: [site_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "detection_rules_ibfk_1")
  feeds               feeds                         @relation(fields: [feed_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "detection_rules_ibfk_2")
  static_items        static_items?                 @relation(fields: [static_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "detection_rules_ibfk_3")
  dynamic_classes     dynamic_classes?              @relation(fields: [dynamic_class_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "detection_rules_ibfk_4")

  @@index([dynamic_class_id], map: "dynamic_class_id")
  @@index([feed_id], map: "feed_id")
  @@index([site_id], map: "site_id")
  @@index([static_item_id], map: "static_item_id")
}
