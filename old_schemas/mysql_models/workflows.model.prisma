model workflows {
  id             Int              @id @default(autoincrement())
  app_id         Int
  name           String           @db.VarChar(255)
  feed_id        Int?
  is_primary     Int?             @default(1)
  created_at     DateTime?        @default(now()) @db.DateTime(0)
  updated_at     DateTime?        @default(now()) @db.DateTime(0)
  description    String?          @db.Text
  ocr            Boolean?         @default(false)
  tamper         Boolean?         @default(false)
  workflow_edges workflow_edges[]
  workflow_nodes workflow_nodes[]
  applications   applications     @relation(fields: [app_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "workflows_ibfk_1")

  @@index([app_id], map: "app_id")
}
