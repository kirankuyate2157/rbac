model workflow_edges {
  id          Int       @id @default(autoincrement())
  workflow_id Int
  edge_id     String    @db.VarChar(100)
  source      String    @db.VarChar(100)
  target      String    @db.VarChar(100)
  data        Json?
  created_at  DateTime? @default(now()) @db.DateTime(0)
  updated_at  DateTime? @default(now()) @db.DateTime(0)
  type        String?   @db.VarChar(255)
  workflows   workflows @relation(fields: [workflow_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "workflow_edges_ibfk_1")

  @@index([workflow_id], map: "workflow_id")
}
