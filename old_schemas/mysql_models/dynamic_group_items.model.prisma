model dynamic_group_items {
  group_id        Int
  dynamic_item_id Int
  dynamic_groups  dynamic_groups @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dynamic_group_items_ibfk_1")
  dynamic_items   dynamic_items  @relation(fields: [dynamic_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "dynamic_group_items_ibfk_2")

  @@id([group_id, dynamic_item_id])
  @@index([dynamic_item_id], map: "dynamic_item_id")
}
