model user_addresses {
  user_id      Int?
  room_no      String?   @db.Text
  locality     String?   @db.VarChar(50)
  area         String?   @db.VarChar(50)
  latitude     Float?
  longitude    Float?
  pincode      Int?
  type         String?   @default("HOME") @db.VarChar(10)
  inactive     Int?      @default(0)
  is_default   Int?      @default(0)
  created_date DateTime? @default(now()) @db.Timestamp(0)
  deleted_date DateTime? @db.Timestamp(0)
  updated_date DateTime? @db.Timestamp(0)
  uid          String?   @db.Char(36)

  @@ignore
}
